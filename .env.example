MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=kashtrix_db
MYSQL_USER=kashtrix
MYSQL_PASSWORD=change-this-database-password
KTE_JWT_SECRET=change-this-long-random-jwt-secret
KTE_DEFAULT_USERNAME=admin
KTE_DEFAULT_PASSWORD=change-this-admin-password
KTE_LICENSE_ADMIN_EMAIL=admin@example.com
KTE_LICENSE_ADMIN_PASSWORD=change-this-license-admin-password
