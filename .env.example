MYSQL_ROOT_PASSWORD=SET_A_UNIQUE_RANDOM_ROOT_PASSWORD
MYSQL_DATABASE=kashtrix_db
MYSQL_USER=kashtrix
MYSQL_PASSWORD=SET_A_UNIQUE_RANDOM_DATABASE_PASSWORD
KTE_JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
# Secure License Manager public authentication URL and raw TLS endpoint.
# Copy the public tenant/application UUIDs from the License Manager admin UI.
KTX_LICENSE_SERVER_URL=https://license.simulcast.com.np
KTX_LICENSE_SERVER_HOST=license.simulcast.com.np
KTX_LICENSE_SERVER_PORT=7443
KTX_LICENSE_SERVERNAME=license.simulcast.com.np
KTX_LICENSE_TENANT_ID=512eb440-cc57-4842-8c6d-51ff83e87adf
KTX_LICENSE_APPLICATION_ID=62ae6ba5-188f-4f63-9007-29f5dd65e036
# Local development paths are resolved from kashtrix-streamops/backend,
# so ../certs/production points to kashtrix-streamops/certs/production.
KTX_LICENSE_CA_PATH=../certs/production/ca-cert.pem
KTX_LICENSE_CLIENT_CERT_PATH=../certs/production/client-cert.pem
KTX_LICENSE_CLIENT_KEY_PATH=../certs/production/client-key.pem
KTX_LICENSE_PUBLIC_KEY_PATH=../certs/production/license-ed25519-public.pem
KTX_LICENSE_EXPECTED_ISSUER=secure-license-manager
KTX_LICENSE_EXPECTED_AUDIENCE=licensed-app
# Use 3000 locally. Set 80 on a production host or point your edge proxy here.
HTTP_PORT=3000
